# Frontend BFF / API URL
NCHE_API_URL=http://localhost:8000

# Command analyst demo access. Change these values for a deployment.
NCHE_ANALYST_EMAIL=analyst@nche.demo
NCHE_ANALYST_PASSWORD=demo-analyst

# API runtime
NCHE_ENV=development
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Neon PostgreSQL connection string. Keep this secret; do not commit it.
# Example: postgresql://user:password@ep-example.us-east-2.aws.neon.tech/nche?sslmode=require
DATABASE_URL=
DATABASE_REQUIRED=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

SIM_RISK_SOURCE=SIMULATED
